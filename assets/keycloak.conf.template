# ==============================================================================
# Red Hat Build of Keycloak Production Server Configuration Template
# File: /opt/keycloak/conf/keycloak.conf
# ==============================================================================

# --- DATABASE CONFIGURATION ---
db=postgres
db-username=keycloak
db-password=keycloak_db_secure_pass
db-url=jdbc:postgresql://db-host.mydomain.com:5432/keycloak
db-pool-min-size=10
db-pool-max-size=100

# --- PROXY & HOSTNAME CONFIGURATION ---
# strict=true enforces verification of incoming Host headers to mitigate HTTP Host Header Injection
hostname-strict=true
hostname-backchannel-dynamic=false
proxy-headers=forwarded
http-relative-path=/auth
http-management-relative-path=/
https-port=443

# --- INTRA-SITE CLUSTERING & CACHE CONFIGURATION (Path A Default) ---
cache=ispn
cache-stack=jdbc-ping

# SPI naming context to isolate cluster nodes and avoid "MsgDroppedDiffCluster" cross-talk
# Change default cluster name to ensure Site A and Site B do not bleed into each other if database is shared.
spi-cache-embedded-default-cluster-name=site-a-kc-cluster

# --- SECURITY & TLS CONFIGURATION ---
# https-key-store-file=/opt/keycloak/conf/server.keystore
# https-key-store-password=keystore_password

# --- OBSERVABILITY (Metrics & Logging) ---
metrics-enabled=true
health-enabled=true
events-listeners=['metrics-listener']
event-metrics-user-enabled=true
event-metrics-user-events=login,logout,code_to_token,refresh_token,register
event-metrics-user-tags=realm,clientId,idp
http-metrics-histograms-enabled=true
cache-metrics-histograms-enabled=true

# --- SYSTEM FILE LOGGING ---
log=file
log-file=/opt/keycloak/log/keycloak.log
log-level=INFO
log-file-rotation-size=20M
log-file-rotation-max-files=5