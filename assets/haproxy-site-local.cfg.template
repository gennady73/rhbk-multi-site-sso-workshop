# ==============================================================================
# RHBK Multi-Site Workshop: Site-Local HAProxy Configuration (Production Hardened)
# File: /etc/haproxy/haproxy.cfg (on sso-lb-a and sso-lb-b)
# ==============================================================================
global
    log 127.0.0.1 local2
    chroot /var/lib/haproxy
    pidfile /var/run/haproxy.pid
    user haproxy
    group haproxy
    maxconn 4096
    daemon
    ssl-skip-self-issued-ca

    # Modern TLS configurations (A+ Security Profile)
    ssl-default-bind-ciphersuites TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256
    ssl-default-bind-options ssl-min-ver TLSv1.2 no-tls-tickets

defaults
    mode http
    log global
    option httplog
    option dontlognull
    option redispatch
    timeout connect 5000
    timeout client 50000
    timeout server 50000

#---------------------------------------------------------------------
# Frontend: Listens for incoming Keycloak traffic
#---------------------------------------------------------------------
frontend keycloak_local_frontend
    bind *:443 ssl crt /etc/haproxy/ssl/haproxy.pem
    
    # CRITICAL SECURITY FIX: Strip incoming Forwarded header from untrusted clients
    # to prevent IP spoofing and HTTP Header injection attacks before appending origin data.
    http-request del-header Forwarded

    # Reconstruct modern 'Forwarded' header safely
    http-request set-var(req.proto) str(https) if { ssl_fc }
    http-request set-var(req.proto) str(http) if !{ ssl_fc }
    http-request set-header Forwarded "for=%[src];proto=%[var(req.proto)];host=%[req.hdr(Host)]"
    
    default_backend keycloak_local_backend

#---------------------------------------------------------------------
# Backend: The pool of Keycloak servers for this site
#---------------------------------------------------------------------
backend keycloak_local_backend
    balance roundrobin
    
    # --- Session Stickiness ---
    # Inspect Keycloak's KC_SESSION cookie prefix to stick requests to the same local node.
    # This prevents extremely expensive remote cross-site cache lookups over the WAN.
    cookie KC_SESSION prefix nocache

    # --- Health Checks ---
    # Health checks target Keycloak's quarkus management interface port (9000).
    option httpchk GET /health/ready HTTP/1.1\r\nHost:\ sso.mydomain.com
    
    # --- Backend Servers ---
    # In production, use 'ssl verify required ca-file /etc/haproxy/ssl/internal-ca.pem' 
    # to authenticate the backend Keycloak JVM nodes using your internal CA certificate bundle.
    server sso1a sso-1-a.mydomain.com:443 check ssl verify required ca-file /etc/haproxy/ssl/internal-ca.pem cookie sso1a check port 9000 check-ssl verify none inter 2000ms rise 2 fall 3
    server sso2a sso-2-a.mydomain.com:443 check ssl verify required ca-file /etc/haproxy/ssl/internal-ca.pem cookie sso2a check port 9000 check-ssl verify none inter 2000ms rise 2 fall 3

#---------------------------------------------------------------------
# HAProxy Stats Page
#---------------------------------------------------------------------
listen stats
    bind *:9090
    mode http
    stats enable
    stats hide-version
    stats realm Haproxy\ Statistics
    stats uri /haproxy?stats
    # In production, protect this endpoint with secure credentials
    # stats auth admin:SecureStatsPass123