[Unit]
Description=Red Hat Build of Keycloak Server (Production Hardened)
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=keycloak
Group=keycloak
WorkingDirectory=/opt/keycloak
ExecStart=/opt/keycloak/bin/kc.sh start --optimized
Restart=on-failure
RestartSec=10s
TimeoutStartSec=600
TimeoutStopSec=600

# OS Process/Thread and File Hardening Limits for Heavy Clustering Load
LimitNOFILE=102400
LimitNPROC=102400
TasksMax=infinity

# Enable unprivileged service to bind to privileged HTTPS port (443) on RHEL 9
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilitiesBoundary=CAP_NET_BIND_SERVICE

# Memory and GC stabilization tuning (adjust as per VM core size)
Environment="JAVA_OPTS_APPEND=-XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+ParallelRefProcEnabled -Dorg.infinispan.threads.virtual=false -Djava.net.preferIPv4Stack=true"

[Install]
WantedBy=multi-user.target