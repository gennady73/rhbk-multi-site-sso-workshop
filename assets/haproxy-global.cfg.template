# ==============================================================================
# RHBK Multi-Site Workshop: Global HAProxy (GSLB) Configuration (Hardened)
# File: /etc/haproxy/haproxy.cfg (on sso-gslb)
# ==============================================================================
global
    log 127.0.0.1 local2
    chroot /var/lib/haproxy
    pidfile /var/run/haproxy.pid
    user haproxy
    group haproxy
    maxconn 4096
    daemon
    ssl-skip-self-issued-ca

    ssl-default-bind-ciphersuites TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256
    ssl-default-bind-options ssl-min-ver TLSv1.2 no-tls-tickets

defaults
    mode http
    log global
    option httplog
    option dontlognull
    option redispatch
    timeout connect 5000
    timeout client 50000
    timeout server 30000

#---------------------------------------------------------------------
# DNS Resolver Section
# Tells HAProxy to query our local authoritative BIND server.
#---------------------------------------------------------------------
resolvers mydns
    nameserver dns1 localhost:53
    accepted_payload_size 8192
    # Sync with our low DNS TTL to resolve dynamic failover switches instantly
    hold valid 5s

#---------------------------------------------------------------------
# Frontend: Public entry point for all client SSO authentication
#---------------------------------------------------------------------
frontend global_sso_frontend
    bind *:443 ssl crt /etc/haproxy/ssl/global.pem
    
    # Strip any incoming spoofed headers before setting secure ones
    http-request del-header Forwarded
    
    http-request set-var(req.proto) str(https) if { ssl_fc }
    http-request set-var(req.proto) str(http) if !{ ssl_fc }
    http-request set-header Forwarded "for=%[src];proto=%[var(req.proto)];host=%[req.hdr(Host)]"
    
    default_backend keycloak_sites

#---------------------------------------------------------------------
# Backend: Dynamic routing via dynamic BIND GSLB resolution
#---------------------------------------------------------------------
backend keycloak_sites
    balance roundrobin
    
    # Stickiness at global entrypoint is critical to ensure a user's
    # full authentication flow remains on the same physical datacenter site.
    cookie KC_SESSION prefix nocache

    # sso-global-lb dynamically queries BIND ('resolvers mydns') 
    # to find the currently active site IP (A or B) and verify SSL connectivity.
    server sso-global-lb sso.mydomain.com:443 check ssl verify required ca-file /etc/haproxy/ssl/internal-ca.pem resolvers mydns init-addr none inter 2000ms